    "motion": "^12.43.0",
    "next": "^16.3.3",
    "node-html-parser": "^9.0.4",
    "openai": "^7.17.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "qpdf-wasm": "^0.1.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.12.2",
    "redis": "^6.2.1",
    "resend": "6.17.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/katex": "^0.16.8",
    "@types/md5": "^2.3.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "lint-staged": "^17.5.1",
    "postcss": "8.5.23",
    "prettier": "3.9.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "wrangler": "^4.131.1"
  }
}

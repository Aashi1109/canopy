{
  "name": "smarttools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "prepare:vendor": "node scripts/copy-media-vendor.mjs",
    "dev": "pnpm run prepare:vendor && next dev -p 3000",
    "db:migrate": "pnpm --filter @smarttools/database migrate",
    "tool:new": "node scripts/new-tool.mjs",
    "admin:promote": "pnpm --filter @smarttools/database promote-admin",
    "build": "pnpm run prepare:vendor && tsc --noEmit && next build --webpack",
    "build:docker": "docker buildx build --platform linux/amd64 --target runner --tag aashishpal09/canopy:latest --push .",
    "build:cloudflare": "opennextjs-cloudflare build && node scripts/clear-cloudflare-build-env.mjs",
    "preview": "pnpm build:cloudflare && node --env-file-if-exists=.env.local node_modules/wrangler/bin/wrangler.js dev --port 8787 --var APP_URL:http://localhost:8787",
    "deploy": "pnpm build:cloudflare && opennextjs-cloudflare deploy",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:media": "node --test --experimental-test-coverage --test-coverage-include='lib/tool-framework/media/**/*.{ts,mts,mjs}' --test-coverage-lines=80 --test-coverage-branches=80 tests/media-*.test.mjs",
    "test:integration": "SMARTTOOLS_INTEGRATION=1 node --test tests/*integration.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@google/genai": "^2.12.0",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "@pdfme/common": "6.1.11",
    "@pdfme/generator": "6.1.11",
    "@pdfme/schemas": "6.1.11",
    "@pdfme/ui": "6.1.11",
    "@react-pdf/renderer": "^4.5.1",
    "@smarttools/auth": "workspace:*",
    "@smarttools/authorization": "workspace:*",
    "@smarttools/control-plane": "workspace:*",
    "@smarttools/database": "workspace:*",
    "@smarttools/invoice-templates": "workspace:*",
    "@smarttools/tool-catalog": "workspace:*",
    "@smarttools/ui": "workspace:*",
    "@uiw/react-codemirror": "^4.25.11",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.6.23",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "heic-to": "1.5.2",
    "js-yaml": "^5.2.2",
    "lucide": "^1.30.0",
    "lucide-react": "^1.25.0",
    "marked": "^18.0.7",
    "md5": "^2.3.0",
    "mermaid": "^11.16.0",
    "morphicons": "^1.5.0",
    "motion": "^12.43.0",
    "next": "^16.3.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "postgres": "^3.4.9",
    "qpdf-wasm": "^0.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/md5": "^2.3.6",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "postcss": "8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "wrangler": "^4.131.1"
  }
}

{
  "name": "canopy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare:vendor": "node scripts/copy-media-vendor.mjs",
    "dev": "pnpm run prepare:vendor && next dev -p 3000",
    "db:migrate": "node db/scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "tool:new": "node scripts/new-tool.mjs",
    "admin:promote": "node db/scripts/promote-admin.mjs",
    "build": "pnpm run prepare:vendor && tsc --noEmit && next build --webpack",
    "build:docker": "docker buildx build --build-arg APP_URL=\"${APP_URL:?Set APP_URL to the public origin}\" --platform linux/amd64 --target runner --tag aashishpal09/canopy:latest --push .",
    "build:cloudflare": "opennextjs-cloudflare build && node scripts/clear-cloudflare-build-env.mjs",
    "preview": "pnpm build:cloudflare && node --env-file-if-exists=.env.local node_modules/wrangler/bin/wrangler.js dev --port 8787 --var APP_URL:http://localhost:8787",
    "deploy": "pnpm build:cloudflare && opennextjs-cloudflare deploy",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "test:media": "node --test --experimental-test-coverage --test-coverage-include='lib/tool-framework/media/**/*.{ts,mts,mjs}' --test-coverage-lines=80 --test-coverage-branches=80 tests/media-*.test.mjs",
    "test:integration": "CANOPY_INTEGRATION=1 node --test tests/*integration.test.mjs",
    "test:e2e": "playwright test"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.69",
    "@base-ui/react": "^1.8.0",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@google/genai": "^2.12.0",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@opennextjs/cloudflare": "^1.20.6",
    "@pdfme/common": "6.1.11",
    "@pdfme/generator": "6.1.11",
    "@pdfme/schemas": "6.1.11",
    "@pdfme/ui": "6.1.11",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/core": "^10.75.0",
    "@sentry/nextjs": "^10.75.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-code-block-lowlight": "3.31.3",
    "@tiptap/extension-mathematics": "3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@uiw/react-codemirror": "^4.25.11",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.105",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.6.23",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "heic-to": "1.5.2",
    "js-yaml": "^5.2.2",
    "katex": "^0.18.7",
    "lowlight": "^3.3.0",
    "lucide": "^1.30.0",
    "lucide-react": "^1.25.0",
    "marked": "^18.0.7",
    "md5": "^2.3.0",
    "mermaid": "^11.16.0",

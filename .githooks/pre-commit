#!/bin/sh

# Check the index only; treat renames as delete/add so removed source still counts.
if ! git diff --cached --quiet --no-renames -- \
  '*.js' '*.jsx' '*.ts' '*.tsx' '*.[cm]js' '*.[cm]ts' \
  '*.css' '*.scss' '*.sql' '*.sh' \
  ':(glob)app/**/*.json' ':(glob)lib/**/*.json' ':(glob)db/**/*.json' \
  ':(glob)tools/**/*.json' ':(glob)tests/**/*.json' \
  package.json pnpm-lock.yaml pnpm-workspace.yaml 'tsconfig*.json' \
  wrangler.jsonc Dockerfile compose.yml .githooks/pre-commit
then
  pnpm test:affected || printf '%s\n' 'Tests failed; continuing with staged-file formatting.'
else
  printf '%s\n' 'No staged source or runtime configuration changes; skipping tests.'
fi

pnpm exec lint-staged

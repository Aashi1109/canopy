APP_URL=http://localhost:3000
# On Vercel, use Supabase's Transaction pooler URL (port 6543).
DATABASE_URL=
# Optional server-side Redis cache via node-redis. Leave REDIS_URL empty to disable.
# Use a separate Redis database per environment. Never use NEXT_PUBLIC_ credentials.
# Reads fall back to the database during outages; failed user/role invalidation blocks writes.
# User profiles cache for 1 hour, roles/catalog for 24 hours, ecosystem for 5 minutes.
# App mutations and admin:promote invalidate caches; direct SQL edits require invalidation.
# Supports redis:// and TLS rediss:// URLs with credentials and an optional /database.
REDIS_URL=
# For pnpm preview: set this to the same database URL (local Hyperdrive bypass).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# Blog scheduled publishing: use the same random bearer secret in the app and Worker.
BLOG_SCHEDULER_SECRET=
# Optional Docker target: HTTPS URL ending in /api/internal/blog/publish-due.
# Leave blank for the Worker's existing WORKER_SELF_REFERENCE service binding.
BLOG_PUBLISH_URL=
# Optional, disposable PostgreSQL database for opt-in blog integration tests only.
BLOG_TEST_DATABASE_URL=

# Authentication and account email.
BETTER_AUTH_SECRET=
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Google Analytics (G-...); requires visitor opt-in.
GA_MEASUREMENT_ID=
# Temporarily enable real analytics and the consent banner during local development.
GA_ENABLE_IN_DEVELOPMENT=false

# Optional integrations and public contact information.
AHREFS_API_KEY=
GEMINI_API_KEY=
SUPPORT_EMAIL=support@smarttools.lol
ACCOUNTS_EMAIL=accounts@smarttools.lol

# Tool icon and blog image uploads and public delivery.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

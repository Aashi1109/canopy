                    {
                      "type": "text",
                      "id": "sgKnT",
                      "name": "Handoff details",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Use each tool’s actual accept list and options. Multiple files use compact thumbnail rows, per-file Remove, count + total size; one Convert action. Success groups JPG previews, filenames, byte sizes and per-file downloads with one primary “Download all · ZIP”. ZIP named from first source; no false partial-success state.",
                      "lineHeight": 1.4,
                      "fontFamily": "$font-body",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "x0qFqE",
                  "name": "04 / Narrow screens & keyboard",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "D5dKj",
                      "name": "04 / Narrow screens & keyboard",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "04 / Narrow screens & keyboard",
                      "lineHeight": 1.4,
                      "fontFamily": "$font-body",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Zbgqm",
                      "name": "Handoff details",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "At 320–390 px: 16 px gutters; wrap filenames. Preview uses contain, not crop. Scroll settings; keep primary action above safe area. 44 px controls, 16 px numeric values. Enter/Space opens previews; Escape closes viewer or overflow and restores focus. Announce progress/errors. Settings opened before upload returns to upload; no Convert until a valid PNG is selected.",
                      "lineHeight": 1.4,
                      "fontFamily": "$font-body",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            },
            {
              "type": "text",
              "id": "hp6vK",
              "name": "Implementation grounding",
              "fill": "$fg-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "SOURCE  tools/png-to-jpg/{definition.ts,run.worker.ts} · media/zip.ts retains individual batch outputs + ZIP. Coast image and byte sizes are illustrative; runtime previews and download facts must come from the actual generated artifact.",
              "lineHeight": 1.4,
              "fontFamily": "$font-body",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]

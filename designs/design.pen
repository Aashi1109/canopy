                    {
                      "type": "text",
                      "id": "mTvjq",
                      "name": "Launch gates",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Owner: backend/product. Confirm lawful service support, allowed hosts/redirects, source eligibility, format manifest, temporary-file lifecycle and retention disclosure before launch. Do not promise private/login/DRM bypass, universal success, unlimited files or local-only processing.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    },

              "fill": "$fg-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Only selecting a tool link navigates to its normal route. Closing Saved leaves the underlying page, input and scroll position untouched. Browser Back after opening a tool returns to the original page; Saved is not a history entry.",
              "lineHeight": 1.45,
              "fontFamily": "$font-body",
              "fontSize": 15,
              "fontWeight": "normal"
            },

        {
          "type": "text",
          "id": "o0bR3V",
          "name": "Long-document behavior",
          "fill": "$accent-text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "LONG DOCUMENTS & OTHER OUTPUT BRANCHES",
          "lineHeight": 1.45,
          "fontFamily": "$font-body",
          "fontSize": 13,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "iZXzp",
          "name": "Long-document requirements",
          "fill": "$fg-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Reuse PdfViewer’s existing page navigation, scrubber, zoom, fit, and outline for documents up to 500 pages. Do not build a separate thumbnail grid. Every-page mode creates one file per page; interval keeps the remainder; custom ranges may omit pages or reuse them across files.",
          "lineHeight": 1.45,
          "fontFamily": "$font-body",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "Qy5W3",
          "name": "Output branches",
          "fill": "$fg-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "ZIP off: show only individual PDFs. ZIP on: add the archive without hiding PDF downloads. For 300 outputs, use a bounded, scrollable result list in the right panel. Do not claim a ZIP download exists when the toggle was off; offer Edit split settings to enable it and rerun.",
          "lineHeight": 1.45,
          "fontFamily": "$font-body",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "Wkq9p",
          "name": "Reentry contract",
          "fill": "$fg-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "EDIT / REPLACE / RESET • Proposed handoff: Edit settings restores the last mode and values. Warn before discarding existing downloads on Replace or Reset. Changing a setting invalidates old results; rerun to create new ones. Reset returns to stage 01. A download leaves the completed state open.",
          "lineHeight": 1.45,
          "fontFamily": "$font-body",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {

                {
                  "type": "frame",
                  "id": "uH7zi",
                  "name": "Single-video interaction contract",
                  "width": "fill_container",
                  "fill": "$surface-muted",
                  "layout": "vertical",
                  "gap": 12,
                  "padding": 24,
                  "children": [
                    {
                      "type": "text",
                      "id": "F3ClSg",
                      "name": "Operation",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "One public video → persistent source preview and file details → one unified Download control. Main action downloads the displayed quality; the arrow exposes explicit Download actions for other available qualities. No separate quality selector, Apply, Prepare file or second confirmation. Original PvnVi remains preserved.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Iwjti",
                      "name": "Quality behavior",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Default main action is Download 720p for this fixture: the highest available video-with-sound file. Clicking it starts preparation and browser handoff directly. The arrow only opens available source download actions. Clicking Download 480p closes the menu and immediately starts that request; it does not merely select 480p. Opening or dismissing the menu never starts a download. Keyboard focus or arrow navigation never triggers a download; activate an explicitly labelled Download action with click, Enter or Space.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "nNlRo",
                      "name": "Preparation and recovery",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Each Download action snapshots source+format, updates displayed file details, and starts preparation. During preparation, hide the alternatives arrow and replace the main action with Cancel preparation. Cancel returns to that quality’s download-ready view without a browser request. Ignore stale or cancelled responses and prevent duplicate requests. Failure shows the shared toast; Retry download retries that file, while an alternative Download action starts the other quality.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Z2K7y",
                      "name": "Completion and fixture",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "After preparation, update actual file size and show Download requested, never Saved. Download again uses the prepared artifact; another quality action prepares its own file and downloads directly. Fixture: 720p 4.2 MB; 480p unknown size until preparation, then 2.1 MB. These are illustrative metadata, not derivation rules. Source playback is independent of the requested download quality.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "g6GSt",
                      "name": "Scope and review",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Additional desktop and mobile interaction proposal, grouped under TikTok. Mobile uses the same source data and selection model, a touch-friendly quality bottom sheet, and a full-width download action. Other single-video sources can use the same behavior; multiple-video posts retain clip selection. Independent ui_validator and end_user_validator agents are unavailable in this session; review is pending.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Nx92A",
                      "name": "Mobile quality interaction",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Mobile uses the same unified control at full width. Main button downloads the displayed quality in one tap. The arrow opens the shared bottom sheet with explicit Download 720p and Download 480p actions, not radio selections. Tapping an action closes the sheet and starts preparation immediately. Close, scrim, Escape or system Back dismiss without downloading. Focus is contained in the sheet; focus alone does not activate anything. Pause source playback when opening. Cancel, retry and browser-handoff behavior match desktop.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]
        },

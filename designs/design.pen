          "textGrowth": "fixed-width",
          "width": 1240,
          "content": "Design contract, not a code migration. Known source issue: the registration-guide link opens /admin/design-system, not a guide. The proposed setup state omits it.",
          "lineHeight": 1.5,
          "fontFamily": "$font-body",
          "fontSize": 13,
          "fontWeight": "normal"
        }

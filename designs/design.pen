                  "width": 454,
                  "height": 750,
                  "layout": "none",
                  "children": [
                    {
                      "type": "text",
                      "id": "iI37h",
                      "x": 0,
                      "y": 0,
                      "name": "Contract heading",
                      "fill": "$accent-text",
                      "textGrowth": "fixed-width",
                      "width": 454,
                      "content": "OPERATION CONTRACT",
                      "lineHeight": 1.45,
                      "fontFamily": "$font-body",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Xl436",
                      "x": 0,
                      "y": 35,
                      "name": "Contract",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": 454,
                      "content": "Crop the visible box of a PDF page. The portrait page owns the workspace; handles resize, the interior moves. Persistent page scope and exact coordinates live in Crop settings. Result facts and download move together below the generated preview.",
                      "lineHeight": 1.45,
                      "fontFamily": "$font-body",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "DiN3w",
                      "x": 0,
                      "y": 131,
                      "name": "Entry heading",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": 454,
                      "content": "Entry & exact transitions",
                      "lineHeight": 1.45,
                      "fontFamily": "$font-body",
                      "fontSize": 19,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "wzHtx",
                      "x": 0,
                      "y": 175,
                      "name": "Entry rules",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": 454,
                      "content": "Choose PDF → full-page crop box. Drag edges to resize; drag inside to move. Example: 36 pt inset.\n\nSettings → 02. Close × or Back to preview → 01, retaining values. Crop tools ··· → Reset crop or Replace PDF. Reset restores full-page bounds.\n\nCrop PDF → disable editing; show “Cropping PDF…” + Cancel. Success → 03. Cancel → 01 with bounds retained.",
                      "lineHeight": 1.45,
                      "fontFamily": "$font-body",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "K4zpOx",
                      "x": 0,
                      "y": 391,
                      "name": "Recovery heading",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": 454,
                      "content": "Safe recovery",
                      "lineHeight": 1.45,
                      "fontFamily": "$font-body",
                      "fontSize": 19,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "z6lvr",
                      "x": 0,
                      "y": 435,
                      "name": "Recovery rules",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": 454,
                      "content": "Invalid bounds → inline field error; block Crop PDF. “Reduce the crop size or choose pages it fits.” Keep inputs.\n\nFailure → “Could not crop PDF. Try again.” Retry retains file and bounds.\n\nMore actions ··· → Edit crop or Crop another PDF. Confirm before discarding undownloaded output. Download PDF saves the artifact; preview stays available.",
                      "lineHeight": 1.45,
                      "fontFamily": "$font-body",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "wVs68",
                      "x": 0,
                      "y": 591,
                      "name": "Limits",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": 454,
                      "content": "PDF ≤50 MiB / 500 pages. Reject encrypted files with “Choose an unprotected PDF.” Original bytes are never overwritten.",
                      "lineHeight": 1.45,
                      "fontFamily": "$font-body",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "Tkoi5",
              "x": 32,
              "y": 1110,
              "name": "Coverage and mobile implementation guidance",
              "width": 1696,
              "height": 250,
              "layout": "none",
              "children": [

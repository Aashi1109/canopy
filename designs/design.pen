                    },
                    {
                      "type": "text",
                      "id": "IZFAF",
                      "name": "1. Describe the work clearly",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "1. Describe the work clearly",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 24,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "RUv5l",
                      "name": "Article paragraph",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Replace vague labels such as “services” with a description your client will recognize. For example, “Homepage copy: research, first draft, and one revision” explains what the charge covers. If you bill by the hour, show both the hours worked and your agreed rate.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 18,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "S2ExqO",
                      "name": "2. Agree on payment terms before you start",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "2. Agree on payment terms before you start",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 24,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "gZeFW",
                      "name": "Article paragraph",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Set the due date and payment method with your client before taking on the project. Then repeat those terms on the invoice. A specific date is clearer than “payment due soon.” If you charge deposits or late fees, only include terms you have agreed on and that comply with applicable rules.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 18,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "h7Q2yj",
                      "name": "3. Send it to the right person",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "3. Send it to the right person",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 24,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "P8r5Vj",
                      "name": "Article paragraph",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Ask who handles billing and whether they need a purchase order or other reference. Send a PDF or a secure invoice link, and use a subject line with the invoice number. Keep a copy so you can check the amount, due date, and payment status later.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 18,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "o0Z5iT",
                      "name": "Common mistakes to avoid",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Common mistakes to avoid",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 24,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "nPRd6",
                      "name": "Article paragraph",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Do not leave out the currency, send an unexplained total, or assume your project contact handles payments. Check your calculations and payment details before sending. Tax and invoice requirements vary by location; check the rules that apply to your business.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 18,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "jhiFs",

            {
              "type": "frame",
              "id": "nW96A",
              "name": "Handoff / inline branches and developer contract",
              "width": "fill_container",
              "height": 750,
              "fill": "$surface",
              "cornerRadius": "$r-xl",
              "gap": 32,
              "padding": 24,
              "children": [
                {
                  "type": "frame",
                  "id": "XPKdC",
                  "name": "Transition specification",
                  "width": 1080,
                  "layout": "vertical",
                  "gap": 12,
                  "children": [
                    {
                      "type": "text",
                      "id": "HA0oI",
                      "name": "Contract title",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "YouTube / implementation contract — proposed, not backend-backed",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 20,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Pjrb9",
                      "name": "Operation model",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Save one authorized public video. Paste a link → inspect the real 16:9 source preview → choose an available video/audio file → prepare → request a browser save. Preview belongs left; persistent format options and artifact actions belong right. No batch list or editing canvas is needed.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "nl5Yu",
                      "name": "Entry and check",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Entry: Downloaders hub or proposed /downloaders/youtube route. Find video (or Enter) trims surrounding whitespace and validates a single youtube.com/watch, youtube.com/shorts or youtu.be URL. Empty/invalid input gets associated inline feedback. Query timestamps may be ignored; playlist-only and live sources are unsupported. Never send cookies, credentials or arbitrary URLs to the fetcher.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "fpNRs",
                      "name": "Fetch transitions",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Find video → Checking source… in the same action panel, with Cancel. Disable repeat submit; preserve editable link after cancel/failure. Success populates preview and a server-supplied format manifest. Change link returns to input with link retained and invalidates old results. Late responses from cancelled/replaced requests are ignored.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "F8aWi",
                      "name": "Availability branches",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Available files are one radio group, not independent Content and Quality selects. Fixture options: 720p MP4 with sound, 360p MP4 with sound, Audio only M4A at 128 kb/s (kilobits per second). Use returned format IDs only. Do not synthesize quality, sound, MP3 or bitrate. No audio track: omit Audio only and show “No audio track available.” No compatible file: use shared unavailable state + Change link.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "d3b4IX",
                      "name": "Preparation and recovery",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Prepare file → Preparing your file… + Cancel in the right panel; retain source preview. No fabricated percentage or countdown. Cancel returns to options. Settings changes invalidate prepared artifacts. Success uses actual server filename, MIME type, dimensions, duration and byte size. Generic service failures use the shared toast/retry pattern owned by the hub session. Expired file → Prepare again, preserving chosen options.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "rBP7L",
                      "name": "Save semantics",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Download → Download requested. Keep Retry download available. Standard browser downloads cannot confirm a disk write; never say Saved automatically. Only a separately supported file-system write API resolving successfully may show Saved to your device. Cancellation is not success; retain file and allow retry. Returning after refresh starts at link entry; do not imply persisted jobs.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "H10m1",
                      "name": "Layout and accessibility",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "1366 × 768 baseline; 1280 × 720 laptop evidence; 390 × 844 mobile evidence. Below 768px use shared mobile nav and stack source → options/result. Page may scroll; no horizontal scroll. Keep 44px actions and labelled controls, keyboard-selectable options, visible focus, and polite live status. Long titles wrap; long URLs and filenames wrap or remain editable horizontally inside their field.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                },

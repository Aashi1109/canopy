        },
        {
          "type": "text",
          "id": "HuIW6",
          "name": "New feature proposal · Admin publishing + public blog · Existing SmartTools component library and design tokens retained.",
          "fill": "$fg-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "New feature proposal · Admin publishing + public blog · Existing SmartTools component library and design tokens retained.",
          "lineHeight": 1.6,

                  "name": "Rule title",
                  "fill": "$fg-primary",
                  "content": "Upload limits and retained files",
                  "fontFamily": "$font-heading",
                  "fontSize": 17,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "RYK0o",
                  "name": "Explicit rule",
                  "fill": "$fg-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Validate incoming files in order. Keep existing valid selection. Reject non-PNGs and files above 25 MiB individually; skip additions beyond 50 files or 100 MiB total. List rejected filenames and the exact limit. For decoded images above 100 MP, name the file and offer Remove file or Replace image. Keep other files and settings.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 13,

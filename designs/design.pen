        },
        {
          "type": "text",
          "id": "GbUzw",
          "name": "Validation and retry",
          "fill": "$fg-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Blank required numbers show “Enter a value”; out-of-range values show the allowed range. Field errors replace helper text and are associated with the field. Focus the first invalid field on Generate. Failure keeps the draft and previous result. Retry with Generate; never fall back to insecure randomness.",
          "lineHeight": 1.4,
          "fontFamily": "$font-body",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "E4hJJU",
          "name": "Reset loading and storage",
          "fill": "$fg-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Completed Generate again uses the applied settings, not an unsubmitted draft. Reset and Example change only the draft in manual mode. During a run disable duplicate submission and announce progress without fake delay. Refresh loses random batches; never persist secrets. Copy feedback follows clipboard success.",
          "lineHeight": 1.4,
          "fontFamily": "$font-body",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "jLMYY",
          "name": "Conditional behavior",
          "fill": "$fg-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Use the same configuration/result/edit modes for all settings-only generators. Lists, paragraphs, code and visual previews adapt only the renderer. Seeded numbers are predictable, not secure. Regex and Border Radius hide Download. Live tools keep configuration expanded and announce updated output.",
          "lineHeight": 1.4,
          "fontFamily": "$font-body",
          "fontSize": 14,
          "fontWeight": "normal"
        }
      ]
    },

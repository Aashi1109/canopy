                  "type": "text",
                  "id": "PY0e7",
                  "name": "Rule title",
                  "fill": "$fg-primary",
                  "content": "Generated JPG preview integration",
                  "fontFamily": "$font-heading",
                  "fontSize": 17,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "V8X3XD",
                  "name": "Explicit rule",
                  "fill": "$fg-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Batch output currently returns a ZIP. Implementation must read JPG entries from that ZIP (or explicitly retain output artifacts), then create local blob URLs from the generated JPG bytes. Use entry filenames and byte sizes. Never substitute source PNGs for JPG output previews. Revoke URLs when replacing/resetting results.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            }

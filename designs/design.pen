          "name": "No-result completion semantics",
          "fill": "$fg-secondary",
          "textGrowth": "fixed-width",
          "width": 620,
          "content": "ResultView.tsx → render: none\nSuccessful completion is not a load error or “No items yet”.\nDo not manufacture a download when no artifact exists.",

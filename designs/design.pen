              "id": "p7csj",
              "name": "OWNERSHIP + FAILURE CONTRACT detail",
              "fill": "$fg-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Empty, delayed local read and storage errors render inside this same popover/sheet. On write failure, retain the prior list and show inline retry. Removing the last item shows the empty state; keep Undo accessible.",
              "lineHeight": 1.45,
              "fontFamily": "$font-body",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "hgM0s",
              "name": "ACCESSIBILITY + OPERATION MODEL",
              "fill": "$accent-text",

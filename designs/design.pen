              "name": "ACCESSIBILITY + OPERATION MODEL detail",
              "fill": "$fg-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Verb: reopen or unbookmark. Object: locally stored tool links. Geometry: short vertical list; no editor or settings. Keep actions ≥44px, visible keyboard focus, contextual names and polite status updates. Menu/search stay mutually exclusive.",
              "lineHeight": 1.45,
              "fontFamily": "$font-body",
              "fontSize": 15,
              "fontWeight": "normal"

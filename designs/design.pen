                {
                  "type": "text",
                  "id": "z64C1",
                  "name": "Unset stays unset. The shown inherited title SETTINGS and stack layout reflect the generic renderer; shell collapse behavior varies by workspace. The proposed resolver must make these flags effective in the custom JSON Formatter workspace too, not just store unused values.",
                  "fill": "$fg-secondary",
                  "textGrowth": "fixed-width",

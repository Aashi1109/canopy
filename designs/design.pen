            {
              "type": "text",
              "id": "ADxZr",
              "name": "Operation & ownership details",
              "fill": "$fg-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Edit the definition’s public content directly in text fields and typed example settings. Existing r13 draft is the input; Save draft persists overrides, Review changes leads to the shared review/publish flow. This is a future feature, not the currently implemented admin form.",
              "lineHeight": 1.5,

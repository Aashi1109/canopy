            {
              "type": "frame",
              "id": "Q0SuF",
              "name": "06–10 / Transformation & momentum",
              "width": 1376,
              "fill": "$surface",
              "layout": "vertical",
              "gap": 40,
              "padding": 48,
              "children": [
                {
                  "type": "frame",
                  "id": "C3hFHK",
                  "name": "Transformation / editorial introduction",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "bH7up",
                      "name": "Chapter",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "SMARTTOOLS     /     IDENTITY EXPLORATIONS     /     06–10",
                      "fontFamily": "$font-body",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "qnZof",
                      "name": "Territory",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Small shifts. More possibility.",
                      "fontFamily": "$font-body",
                      "fontSize": 48,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "N9lYZ",
                      "name": "Thesis",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Five ways to make everyday work feel lighter. Distinct silhouettes, one calm wordmark, and a consistent identity from browser tab to social profile.",
                      "fontFamily": "$font-body",
                      "fontSize": 19,
                      "fontWeight": "normal"
                    },

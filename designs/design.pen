          "fill": "$fg-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "ENTRY & ACCESSIBILITY   Existing conversion URLs preselect the target; no re-upload on switching. Only one source format per batch in this proposal. Format choices use an accessible single-selection group, visible focus, and keyboard access. Unsupported choices explain why inline and on focus. File preview/remove/download controls retain filename-specific labels.",
          "lineHeight": 1.5,
          "fontFamily": "$font-body",
          "fontSize": 13,
          "fontWeight": "normal"
        }

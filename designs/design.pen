                {
                  "type": "text",
                  "id": "cbvw1",
                  "name": "Discovery contract rules",
                  "fill": "$fg-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Browse tools → search or choose a category → open the matching tool. Names and one-line purpose lead; icons support recognition. The catalog links to tools; it never processes files or code.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "VlzVD",
                  "name": "Discovery contract details",
                  "fill": "$fg-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Keep q and category in the URL. Submitting an empty search shows the current category. Category links preserve the submitted query. Clear search keeps the category; Clear filters resets both.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },

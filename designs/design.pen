    {
      "type": "frame",
      "id": "u8c7eE",
      "x": 109005,
      "y": 15981,
      "name": "Improve / Working → Accept or discard → Applied",
      "context": "Persist the exact selected range and its blue highlight during loading, streaming, retry, and suggestion review, even when a popover control takes focus. Do not overwrite the original before Accept. Accept replaces only that anchored range as one undoable edit, then swaps blue selection for a brief success highlight. Cancel/Discard close helper and restore focus and original selection. If anchored content changes, block stale acceptance and ask to regenerate. Announce status accessibly; no pulsing required.",
      "width": 1456,
      "fill": "$surface-muted",
      "gap": 24,
      "padding": 24,
      "children": [
        {
          "type": "frame",
          "id": "M0rCw",
          "name": "1 — Working after Reduce text",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 20,
          "children": [
            {
              "type": "text",
              "id": "ftVTc",
              "name": "Step",
              "fill": "$fg-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "1  Working",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 20,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "l9RkO",
              "name": "Persistent selection highlight",
              "context": "Retain the exact editor selection as a persistent highlight while generating and reviewing, even when focus moves to Cancel, Accept or Discard. Never clear it merely because the editor loses focus.",
              "width": "fill_container",
              "fill": "$accent-soft",
              "cornerRadius": 4,
              "layout": "vertical",
              "padding": [
                6,
                8
              ],
              "children": [
                {
                  "type": "text",
                  "id": "D3wF0",
                  "name": "Original text — preserved selection",
                  "fill": "$accent-text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "You have finished the work. Now make it easy for your client to pay you. A clear freelance invoice explains what you delivered, what it costs, and when payment is due. You do not need a complicated system—just the right details and a consistent process.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "KK7e0",
              "name": "Working popover — AI rewriting task",
              "context": "Compact active AI task, not a clickable surface. Indeterminate activity strip, no percentage or invented completion time. In implementation, move the 72px light-blue segment gently across its track while request is active; static segment with status text for reduced motion. Do not pulse the selected text. Cancel aborts and keeps original; completion swaps task content for the Accept/Discard preview. Announce status once, not each activity frame.",
              "width": "fill_container",
              "fill": "$surface",
              "cornerRadius": 12,
              "stroke": "$border-subtle",
              "strokeWidth": 1,
              "effect": {
                "type": "shadow",

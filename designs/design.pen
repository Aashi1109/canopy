                }
              }
            },
            {
              "id": "ELNrM",
              "type": "ref",
              "ref": "dV2U8",
              "name": "Private save success specimen",
              "width": "fill_container",
              "fill": "$success-soft",
              "descendants": {
                "fF9w0": {

                      "type": "text",
                      "id": "IUSIg",
                      "x": 0,
                      "y": 0,
                      "name": "STATE / HANDOFF REQUIREMENTS",
                      "fill": "$accent-text",
                      "textGrowth": "fixed-width",
                      "width": 400,
                      "content": "STATE / HANDOFF REQUIREMENTS",
                      "lineHeight": 1.45,
                      "fontFamily": "$font-body",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "DEVjW",
                      "x": 0,
                      "y": 31,
                      "name": "Guidance",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": 400,
                      "content": "At short heights, scroll the preview area; keep the primary action reachable with safe-area padding. Focus returns to Crop settings on close; announce crop size and completion. Reset returns full bounds. Refresh is not durable storage: warn before abandoning work. Validate 320 px, text zoom, keyboard, long filenames and touch on device.",
                      "lineHeight": 1.45,
                      "fontFamily": "$font-body",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]

                    {
                      "type": "text",
                      "id": "RlqrF",
                      "name": "A practical starting point, not tax or legal advice.",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A practical starting point, not tax or legal advice.",

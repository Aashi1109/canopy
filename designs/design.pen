          "gap": 24,
          "children": [
            {
              "type": "text",
              "id": "lSPw7",
              "name": "Lists & recovery label",
              "fill": "$fg-primary",
              "textGrowth": "fixed-width",
              "width": 220,
              "content": "Lists & recovery",
              "fontFamily": "$font-body",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "OspR3",
              "name": "Lists & recovery details",
              "fill": "$fg-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Each list edits one selected item; Previous / Next select without discarding edits. Add appends and focuses a blank item. Move opens a destination-position picker with Move up / Move down keyboard actions. Remove offers Undo; selected index and count update. Disable boundary actions (first/last and single-item lists) with accessible explanations.",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "S3yGU",
          "name": "Optional coverage",
          "width": "fill_container",
          "gap": 24,
          "children": [
            {
              "type": "text",
              "id": "j54ZY3",
              "name": "Optional coverage label",
              "fill": "$fg-primary",
              "textGrowth": "fixed-width",
              "width": 220,
              "content": "Optional coverage",
              "fontFamily": "$font-body",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "i7MGnD",
              "name": "Optional coverage details",
              "fill": "$fg-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "seoTitle and relatedToolIds are proposed draft additions, absent from the shipped JSON Formatter definition. Blank optional fields offer “Use code default”; omission inherits code, [] explicitly clears optional lists. Keep at least one nonblank howToUse step. FAQ uses q/a, not rich text. Preserve other items in all four-item lists.",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "FC2vV",
          "name": "Example values",
          "width": "fill_container",
          "gap": 24,
          "children": [
            {
              "type": "text",
              "id": "YuvAg",
              "name": "Example values label",
              "fill": "$fg-primary",
              "textGrowth": "fixed-width",
              "width": 220,
              "content": "Example values",
              "fontFamily": "$font-body",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "vsjSc",
              "name": "Example values details",
              "fill": "$fg-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "settings is an optional object. Include / omit each override independently; choices here are operation: format|minify|validate and indentation: 2|4|tab (strings). Show indentation only for format; retain but explain hidden values. Secondary is omitted and disabled for JSON Formatter; tools with a declared secondary channel get a populated editable textarea. Reject unknown keys and type/value mismatches at /content/examples/{index}/settings/{key}.",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "pTTp1",
          "name": "Validation & interaction",
          "width": "fill_container",
          "gap": 24,
          "children": [
            {
              "type": "text",
              "id": "wh3RM",
              "name": "Validation & interaction label",
              "fill": "$fg-primary",
              "textGrowth": "fixed-width",
              "width": 220,
              "content": "Validation & interaction",
              "fontFamily": "$font-body",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "Ba93R",
              "name": "Validation & interaction details",
              "fill": "$fg-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Trim and validate relatedToolIds against catalog IDs, rejecting unknown, duplicate and self references. Errors attach to exact field paths and focus the first invalid control. Save confirms the revision; save failure preserves the buffer and offers Retry. Unsaved navigation offers Stay / Discard / Save. Keyboard focus and accessible names are required for every control.",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        }
      ]
    },

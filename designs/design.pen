    {
      "type": "frame",
      "id": "P95fR",
      "x": 207309,
      "y": -33312,
      "name": "Focus mode / Developer handoff — transitions, recovery and acceptance",
      "width": 1366,
      "height": 790,
      "fill": "$surface",
      "layout": "none",
      "children": [
        {
          "type": "text",
          "id": "A4fUe",
          "x": 40,
          "y": 40,
          "name": "Handoff title",
          "fill": "$fg-primary",
          "textGrowth": "fixed-width",
          "width": 1286,
          "content": "Markdown Previewer / Focus mode, matched to the current product",
          "lineHeight": 1.5,
          "fontFamily": "$font-body",
          "fontSize": 28,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "h8nq8",
          "x": 40,
          "y": 106,
          "name": "Scope",
          "fill": "$accent-text",
          "textGrowth": "fixed-width",
          "width": 1286,
          "content": "LIVE PRODUCT BASELINE · localhost:3000/devtools/markdown-previewer · 1366 × 768 and 1280 × 720 browser viewports.",
          "lineHeight": 1.5,
          "fontFamily": "$font-body",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "F308fa",
          "x": 40,
          "y": 151,
          "name": "Interaction contract columns",
          "width": 1286,
          "gap": 40,
          "children": [
            {
              "type": "frame",
              "id": "n6sS4",
              "name": "Flow and ownership",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "text",
                  "id": "hNyrW",
                  "name": "Operation model",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "TASK / Write, inspect and export Markdown",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "v3L69t",
                  "name": "Direct interaction",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Keep the current CodeMirror editor, line numbers, Wrap lines control, character count, Paste and Upload actions. The built-in Example is “# Preview” with Fast / Private bullets; all states show that same document. Rendering stays automatic.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "X9wmN",
                  "name": "Flow mapping",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "01 → 02   Add Expand workspace beside existing Example / Reset. Preserve the current workspace; hide the site navbar, breadcrumb and page intro.\n02 → 03   The existing edge settings handle opens the right panel. Its chevron collapses the panel again.\n02 / 03 → 04   Preview hides Source; Split restores both. Source shows the editor alone.\nExit focus mode restores the standard page and prior scroll position.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "G9yt6e",
                  "name": "Preserved state",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Keep the same editor/runtime mounted. Preserve text, undo history, settings, pane proportions and each pane’s scroll anchor. Mode changes do not save, clear, upload or rerun the document.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "MoSTQ",
                  "name": "Space and keyboard",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Keep the current 1 px resizable divider, 3 × 24 px grip and 24 px hit region. Settings remains a 320 px right panel when open. The normal workbench starts at y=241 and extends below the 768 px fold, as in the current product; the expanded workbench fits the viewport.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "AKBqM",
              "name": "Feedback and recovery",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "text",
                  "id": "A2HHT6",
                  "name": "Output contract",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "OUTPUT / HTML, not a saved Markdown file",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "teLwt",
                  "name": "Export",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Retain the current icon-only Copy and Download actions next to the Preview / READY label. Shared tooltips disclose Copy all (HTML) and Download .html on hover/focus. Keep current preparing, copied and export-error feedback; focus mode does not change the output contract.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "SPnKp",
                  "name": "Feedback states",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Reuse shared Toast: “HTML copied.” Export failure: “Could not download the HTML. Try again.” Keep the document and allow retry. While rendering, status reads “Rendering Markdown…”; identify any retained preview as “Updating…”. Export only the current rendered revision.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "KNaSG",
                  "name": "Input recovery",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Keep current Example, Reset, Paste and Upload behavior, validation and confirmation dialogs. Do not invent an Undo toolbar button, file menu or autosave. Editor undo history and the existing runtime survive view changes. Empty-input and invalid-file feedback reuse the current shared states.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Jdy1m",
                  "name": "Keyboard and reentry",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Escape closes an open menu/panel first; otherwise it exits focus mode. Return focus to the trigger that opened the view. Refresh/navigation persistence is not promised. Warn before losing unsaved work; do not label the document “Saved”.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "lrr6B",
                  "name": "Responsive rule",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Below the two-pane minimum, show Source / Preview tabs instead of Split. Settings opens over the right side, with focus management. Keep Exit and export available; do not shrink labels or controls to make them fit.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "id": "GjYcl",
          "x": 40,
          "y": 673,
          "name": "QA checklist",
          "fill": "$fg-secondary",
          "textGrowth": "fixed-width",
          "width": 1286,
          "content": "REVIEW / Matched against live standard and settings-open screenshots. Current navbar, breadcrumb, intro, controls, settings order and status retained. Focus adds only expansion/exit and view selection.\nIndependent ui_validator / end_user_validator: BLOCKED — agent tools unavailable. Runtime interaction testing remains required.",
          "lineHeight": 1.5,
          "fontFamily": "$font-body",
          "fontSize": 14,
          "fontWeight": "normal"
        }
      ]
    },

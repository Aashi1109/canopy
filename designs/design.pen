                  "name": "RESULT INTEGRITY details",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Changing format keeps the previous result explicitly labelled and downloadable. Convert always uses original uploads. New results replace old results only when successful; cancel/failure retains the prior download. New batch clears sources after an explicit reset action.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }

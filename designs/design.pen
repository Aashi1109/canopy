                        {
                          "type": "text",
                          "id": "k4t51c",
                          "name": "Cover · 1600 × 900",
                          "fill": "$fg-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Cover · 1600 × 900",
                          "lineHeight": 1.5,

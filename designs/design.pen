          "y": 914,
          "name": "Retry pending semantics",
          "fill": "$fg-secondary",
          "textGrowth": "fixed-width",
          "width": 720,
          "content": "Loading · prevent duplicate requests; announce updates politely.\nKeep the safe destination available. Never claim data was saved unless verified.",
          "lineHeight": 1.5,
          "fontFamily": "$font-body",
          "fontSize": 13,
          "fontWeight": "normal"
        }
      ]
    },

                      "width": 400,
                      "content": "CROP / ROTATE",
                      "lineHeight": 1.45,
                      "fontFamily": "$font-body",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Fh0iA",
                      "x": 0,
                      "y": 31,
                      "name": "Guidance",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": 400,
                      "content": "Crop: CropFrame + crop-pdf/workspace.tsx. All / odd / even / custom scope; custom reveals a page-range field. One box must fit every selected page; unselected pages remain. Rotate: select real page previews, apply 90° steps and show orientation before generation. Never turn a navigator into the task surface.",
                      "lineHeight": 1.45,
                      "fontFamily": "$font-body",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "esdRb",
                  "x": 864,
                  "y": 0,
                  "name": "NARROW SCREENS / TOUCH",
                  "width": 400,
                  "height": 250,
                  "layout": "none",
                  "children": [
                    {
                      "type": "text",
                      "id": "FwaUW",
                      "x": 0,
                      "y": 0,
                      "name": "NARROW SCREENS / TOUCH",
                      "fill": "$accent-text",
                      "textGrowth": "fixed-width",
                      "width": 400,
                      "content": "NARROW SCREENS / TOUCH",
                      "lineHeight": 1.45,
                      "fontFamily": "$font-body",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "TfgzF",
                      "x": 0,
                      "y": 31,
                      "name": "Guidance",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": 400,
                      "content": "320–430 px: 16 px gutters, no page-level horizontal scroll. Fit the page to available width; preserve aspect ratio. Crop handles keep small visible grips with ≥44 px non-overlapping hit targets. Drag captures pointer only on bounds; outside remains scrollable. Numeric fields provide a non-drag alternative.",
                      "lineHeight": 1.45,
                      "fontFamily": "$font-body",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "sng12",
                  "x": 1296,
                  "y": 0,
                  "name": "STATE / HANDOFF REQUIREMENTS",
                  "width": 400,
                  "height": 250,
                  "layout": "none",
                  "children": [
                    {
                      "type": "text",
                      "id": "IUSIg",
                      "x": 0,
                      "y": 0,
                      "name": "STATE / HANDOFF REQUIREMENTS",
                      "fill": "$accent-text",
                      "textGrowth": "fixed-width",
                      "width": 400,
                      "content": "STATE / HANDOFF REQUIREMENTS",
                      "lineHeight": 1.45,
                      "fontFamily": "$font-body",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "DEVjW",
                      "x": 0,
                      "y": 31,
                      "name": "Guidance",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": 400,
                      "content": "At short heights, scroll the preview area; keep the primary action reachable with safe-area padding. Focus returns to Crop settings on close; announce crop size and completion. Reset returns full bounds. Refresh is not durable storage: warn before abandoning work. Validate 320 px, text zoom, keyboard, long filenames and touch on device.",
                      "lineHeight": 1.45,
                      "fontFamily": "$font-body",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]

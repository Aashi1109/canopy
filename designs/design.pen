                  "fontFamily": "$font-body",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "t9NMLf",
                  "name": "Responsive & accessible rules",
                  "fill": "$fg-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Stack the search action only when its label no longer fits. Use one card column at narrow widths, then add columns when descriptions retain a readable measure. Replace long category rails with a labeled select.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "XxL8x",
                  "name": "Responsive & accessible details",
                  "fill": "$fg-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Use native search forms and links. Show 2px focus rings, 44px touch targets, 16px mobile input text, and full wrapping descriptions. Tool links include the tool name. Category selection has text plus a non-color cue.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },

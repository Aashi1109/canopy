                    {
                      "type": "text",
                      "id": "IQWW9",
                      "name": "You did the work. Getting paid should be the easy part. A clear invoice tells your client what they’re paying for, when it’s due, and exactly how to pay.",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "You did the work. Getting paid should be the easy part. A clear invoice tells your client what they’re paying for, when it’s due, and exactly how to pay.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "n6Mv4r",
                      "name": "01  Make the essentials impossible to miss",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "01  Make the essentials impossible to miss",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 26,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "DKj8P",
                      "name": "Start with your business name, your client’s details, a unique invoice number, and the issue date. Give each line item a plain-language description so the total never needs explaining.",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Start with your business name, your client’s details, a unique invoice number, and the issue date. Give each line item a plain-language description so the total never needs explaining.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "o8lSuD",
                      "name": "Example invoice line item",
                      "width": "fill_container",
                      "fill": "$surface-muted",
                      "cornerRadius": "$r-md",
                      "layout": "vertical",
                      "gap": 8,
                      "padding": 24,
                      "children": [
                        {
                          "type": "text",
                          "id": "uYoK8",
                          "name": "INSTEAD OF “DESIGN WORK”",
                          "fill": "$fg-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "INSTEAD OF “DESIGN WORK”",
                          "lineHeight": 1.6,
                          "fontFamily": "$font-body",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "QrbAh",
                          "name": "Website design — homepage and contact page",
                          "fill": "$fg-primary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Website design — homepage and contact page",
                          "lineHeight": 1.6,
                          "fontFamily": "$font-body",
                          "fontSize": 18,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "x3hkSF",
                          "name": "12 hours × $75.00 = $900.00",
                          "fill": "$fg-primary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "12 hours × $75.00 = $900.00",
                          "lineHeight": 1.6,
                          "fontFamily": "$font-body",
                          "fontSize": 17,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "R72uFx",
                          "name": "Specific scope. Clear quantity. No guesswork.",
                          "fill": "$fg-secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Specific scope. Clear quantity. No guesswork.",
                          "lineHeight": 1.6,
                          "fontFamily": "$font-body",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "UiZQN",
                      "name": "02  Make the next step obvious",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "02  Make the next step obvious",
                      "lineHeight": 1.2,
                      "fontFamily": "$font-body",
                      "fontSize": 28,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "o8bZPV",
                      "name": "Write a real due date rather than “payment due soon.” Include the payment method you agreed on and any reference the client needs to use. If you collect tax, show it separately from your subtotal.",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Write a real due date rather than “payment due soon.” Include the payment method you agreed on and any reference the client needs to use. If you collect tax, show it separately from your subtotal.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 18,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "MkZ0V",
                      "name": "A useful note is short and specific: “Payment is due October 1, 2026. Please include invoice INV-1042 with your transfer.” Confirm payment details with your client through a trusted channel.",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A useful note is short and specific: “Payment is due October 1, 2026. Please include invoice INV-1042 with your transfer.” Confirm payment details with your client through a trusted channel.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 18,
                      "fontWeight": "normal"
                    },
                    {
                      "id": "BYnAq",
                      "type": "ref",
                      "ref": "dV2U8",
                      "width": "fill_container",
                      "name": "Payment safety note",
                      "descendants": {
                        "TK55X": {
                          "content": "Keep sensitive details out of public examples",
                          "textGrowth": "fixed-width",
                          "width": "fill_container"
                        },
                        "dTfwI": {
                          "content": "Use sample names and account details when sharing an invoice. Never publish a client’s financial information."
                        }
                      }
                    },
                    {
                      "type": "text",
                      "id": "dFVkS",
                      "name": "03  A 30-second check before you send",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "03  A 30-second check before you send",
                      "lineHeight": 1.2,
                      "fontFamily": "$font-body",
                      "fontSize": 28,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "USRNH",
                      "name": "• Check the client’s name and billing address.\n• Confirm line items, totals, and the due date.\n• Export a PDF and check that it matches your preview.\n• Keep a copy with your project records.",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "• Check the client’s name and billing address.\n• Confirm line items, totals, and the due date.\n• Export a PDF and check that it matches your preview.\n• Keep a copy with your project records.",
                      "lineHeight": 1.6,
                      "fontFamily": "$font-body",
                      "fontSize": 18,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "kjPCO",
                      "name": "You don’t need a complicated system to look professional. You need a document that answers the obvious questions before your client has to ask them.",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "You don’t need a complicated system to look professional. You need a document that answers the obvious questions before your client has to ask them.",

                  "width": "fill_container",
                  "fill": "$warning-soft",
                  "context": "Only offer download if the tool supports it. Keep source/result intact. Use polite status on copy failure; copy action remains available.",
                  "descendants": {
                    "fF9w0": {
                      "icon": "clipboard",
                      "fill": "$warning-text"
                    },
                    "TK55X": {
                      "content": "Could not copy"
                    },
                    "dTfwI": {
                      "content": "Select the result to copy manually, or download it.",
                      "fontSize": 14
                    }
                  }
                },
                {
                  "id": "MTZTV",
                  "type": "ref",
                  "ref": "dV2U8",
                  "name": "Processing state — retain input",
                  "width": "fill_container",
                  "context": "Static state reference. Announce status; no fake determinate percentage. Show Cancel only when actual execution adapter supports cancellation; otherwise never promise it.",
                  "descendants": {
                    "fF9w0": {
                      "icon": "loader-circle"
                    },
                    "TK55X": {
                      "content": "Processing…"
                    },
                    "dTfwI": {
                      "content": "Keep this page open. Your source is unchanged.",
                      "fontSize": 14
                    }
                  }
                },
                {
                  "id": "ckUoW",
                  "type": "ref",
                  "ref": "dV2U8",
                  "name": "Input changed — stale result",
                  "width": "fill_container",
                  "fill": "$warning-soft",
                  "context": "Manual-trigger tools only. Label output state explicitly and preserve prior artifact until successful replacement. Live tools use their actual update behavior instead.",
                  "descendants": {
                    "fF9w0": {
                      "icon": "circle-alert",
                      "fill": "$warning-text"
                    },
                    "TK55X": {
                      "content": "Result is out of date"
                    },
                    "dTfwI": {
                      "content": "The input changed. Run the tool again to update this result.",
                      "fontSize": 14
                    }
                  }
                },
                {
                  "type": "text",
                  "id": "Oknv7",
                  "name": "State adoption rules",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Use the tool’s actual execution model. A live counter does not need Run; a synchronous generator does not need a fake processing step. No cancellation, history, persistence, download or undo claims unless supported.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "tphQz",
                  "name": "Recovery specification",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Reset uses the dialog shown here. Clear input is distinct from resetting settings. Example loading prompts before replacing edits. Failed upload keeps valid existing files. Error copy identifies the failing input and a valid next action.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "qRol6",
                  "name": "Verification boundary",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Canvas checks can verify size, alignment, visible copy, static contrast and clipping. They cannot prove screen-reader behavior, focus order, clipboard access, uploads, real processing, cancellation or download correctness.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
    },

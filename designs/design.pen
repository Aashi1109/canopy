      },
      "layout": "vertical",
      "gap": 20,
      "padding": 28,
      "children": [
        {
          "type": "text",
          "id": "iv2sR",
          "name": "HANDOFF / Proposed runtime-config feature · documentation, not application UI",
          "fill": "$accent-text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "HANDOFF / Proposed runtime-config feature · documentation, not application UI",
          "lineHeight": 1.45,
          "fontFamily": "$font-body",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "qbgva",
          "name": "Settings coverage columns",
          "width": "fill_container",
          "gap": 28,
          "children": [
            {
              "type": "frame",
              "id": "LmwZI",
              "name": "01 / Edit deployed fields",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "bIeXE",
                  "name": "01 / Edit deployed fields",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "01 / Edit deployed fields",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "BefkX",
                  "name": "Primary job: configure a tool definition. Select one of the two fields; edit its label, help, choices, default and placement directly. The private preview uses the draft, not the published tool.",
                  "fill": "$fg-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Primary job: configure a tool definition. Select one of the two fields; edit its label, help, choices, default and placement directly. The private preview uses the draft, not the published tool.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "L0qhz",
                  "name": "Operation: key operation; kind select; string values format, minify, validate. Editable labels Format, Minify, Validate; default format. Help: “Format, minify, or only validate the JSON.” Visibility: Always.",
                  "fill": "$fg-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Operation: key operation; kind select; string values format, minify, validate. Editable labels Format, Minify, Validate; default format. Help: “Format, minify, or only validate the JSON.” Visibility: Always.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "X2RVeM",
                  "name": "Indentation: key indentation; kind select; values \"2\", \"4\", \"tab\". Choose exactly one default. Clicking Set default selects that row and updates the preview. Values and kinds cannot be changed or added outside the deployed contract.",
                  "fill": "$fg-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Indentation: key indentation; kind select; values \"2\", \"4\", \"tab\". Choose exactly one default. Clicking Set default selects that row and updates the preview. Values and kinds cannot be changed or added outside the deployed contract.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "v3wBW",
                  "name": "Pane selector: Inherit / main / side. Span: Inherit / 1 / 2 / full. Visibility: Always, or When → deployed key + equals value with its native type. For indentation: operation equals \"format\".",
                  "fill": "$fg-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Pane selector: Inherit / main / side. Span: Inherit / 1 / 2 / full. Visibility: Always, or When → deployed key + equals value with its native type. For indentation: operation equals \"format\".",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "tjcel",
              "name": "02 / Complete field-kind coverage",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "PBknP",
                  "name": "02 / Complete field-kind coverage",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "02 / Complete field-kind coverage",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "B5TFzy",
                  "name": "All kinds share label, help, pane, span, visibleWhen and a typed default. Selecting a field loads the editor for its deployed kind; there is no unrestricted kind picker.",
                  "fill": "$fg-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "All kinds share label, help, pane, span, visibleWhen and a typed default. Selecting a field loads the editor for its deployed kind; there is no unrestricted kind picker.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "r5b9yP",
                  "name": "text → default, placeholder, maxLength\ntextarea → default, rows\npassword → default, placeholder; never use for secrets (settings persist)\nnumber → default, min, max, step, suffix, leadingIcon (unset / rotate-cw)\nslider → default, required min/max, step, suffix\ntoggle → boolean default",
                  "fill": "$fg-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "text → default, placeholder, maxLength\ntextarea → default, rows\npassword → default, placeholder; never use for secrets (settings persist)\nnumber → default, min, max, step, suffix, leadingIcon (unset / rotate-cw)\nslider → default, required min/max, step, suffix\ntoggle → boolean default",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "vUfDq",
                  "name": "select → label/value choices + default\npreset → choices + detail, aspectRatio, default\ncolor → default + allowTransparent\ndate → ISO date default\nposition → 3×3 position default\npages → all / odd / even / page list + presets\nrows → editable key/value rows + keyLabel/valueLabel\nChoice aspectRatio is also supported for select.",
                  "fill": "$fg-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "select → label/value choices + default\npreset → choices + detail, aspectRatio, default\ncolor → default + allowTransparent\ndate → ISO date default\nposition → 3×3 position default\npages → all / odd / even / page list + presets\nrows → editable key/value rows + keyLabel/valueLabel\nChoice aspectRatio is also supported for select.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "jEoAP",
              "name": "03 / Validation & recovery",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "E0A3Jh",
                  "name": "03 / Validation & recovery",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "03 / Validation & recovery",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "a4vkH1",
                  "name": "Proposed server gate: reject unknown keys, type changes and unsupported enum values against a versioned deployed contract. Runtime parseSettings fallback is not sufficient publish validation. New behavior still requires implementation code.",
                  "fill": "$fg-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Proposed server gate: reject unknown keys, type changes and unsupported enum values against a versioned deployed contract. Runtime parseSettings fallback is not sufficient publish validation. New behavior still requires implementation code.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "O3Qa8",
                  "name": "Validate defaults by kind; unique choice values; default in choices; finite numeric bounds and positive step; valid dates, colors, page lists and row pairs. Reject unknown or cyclic visibility references. Empty optional controls remove the override; empty required labels show inline errors.",
                  "fill": "$fg-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Validate defaults by kind; unique choice values; default in choices; finite numeric bounds and positive step; valid dates, colors, page lists and row pairs. Reject unknown or cyclic visibility references. Empty optional controls remove the override; empty required labels show inline errors.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "JhX8a",
                  "name": "Example error at default: “Choose an available value: 2, 4 or tab.” Keep edits; block Review changes until corrected. Reset field to live asks for confirmation and restores r12 for this field only.",
                  "fill": "$fg-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Example error at default: “Choose an available value: 2, 4 or tab.” Keep edits; block Review changes until corrected. Reset field to live asks for confirmation and restores r12 for this field only.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "zcMam",
                  "name": "Save draft → private revision, no public changes. Save failure keeps edits with Retry. Version conflict offers reload or comparison before overwrite. Review changes opens the existing review step; publishing is never implied by Save.",
                  "fill": "$fg-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Save draft → private revision, no public changes. Save failure keeps edits with Retry. Version conflict offers reload or comparison before overwrite. Review changes opens the existing review step; publishing is never implied by Save.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "BVAJR",
      "x": 175169,
      "y": -28851,
      "name": "Behavior and layout — developer documentation below viewport",
      "width": 1366,
      "fill": "$surface",
      "stroke": "$border-strong",
      "strokeWidth": {
        "top": 1
      },
      "layout": "vertical",
      "gap": 20,
      "padding": 28,
      "children": [
        {
          "type": "text",
          "id": "f1jOYr",
          "name": "HANDOFF / Proposed runtime-config feature · documentation, not application UI",
          "fill": "$accent-text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "HANDOFF / Proposed runtime-config feature · documentation, not application UI",
          "lineHeight": 1.45,
          "fontFamily": "$font-body",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "mFCHO",
          "name": "Behavior coverage and manual branch",
          "width": "fill_container",
          "gap": 28,
          "children": [
            {
              "type": "frame",
              "id": "CWgQh",
              "name": "01 / Behavior & presentation contract",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "J7J87",
                  "name": "01 / Behavior & presentation contract",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "01 / Behavior & presentation contract",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "MGIIv",
                  "name": "Live serializes {mode: \"live\", debounceMs: 120}. Debounce is optional; accept a finite non-negative integer. Manual serializes {mode: \"manual\", actionLabel}. Require a nonblank action label; omit debounceMs. Switching back restores the draft Live values.",
                  "fill": "$fg-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Live serializes {mode: \"live\", debounceMs: 120}. Debounce is optional; accept a finite non-negative integer. Manual serializes {mode: \"manual\", actionLabel}. Require a nonblank action label; omit debounceMs. Switching back restores the draft Live values.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "WobwG",
                  "name": "Capabilities: copy, download, cancel, progress, network each support Inherit / On / Off. Click an available switch to toggle; reset to Inherit through its keyboard-accessible help menu. Copy and download are true for JSON Formatter. Others are unset, not explicitly false.",
                  "fill": "$fg-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Capabilities: copy, download, cancel, progress, network each support Inherit / On / Off. Available switches toggle On/Off; the implementation must expose Reset to deployed in the capability group. Copy and download are true; others are unset, not explicitly false.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "cOo8M",
                  "name": "A capability cannot create worker or network support. Keep unavailable switches disabled with focusable explanation. Guard enabling against deployment metadata; never rewrite execution host or worker module through admin JSON.",
                  "fill": "$fg-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A capability cannot create worker or network support. Keep unavailable switches disabled with focusable explanation. Guard enabling against deployment metadata; never rewrite execution host or worker module through admin JSON.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "EfuvC",
                  "name": "layout: Inherit / side-by-side / stacked. workbenchMark: optional group; text plus tone Inherit / accent / contrast. Clearing the group removes it. Labels: empty, ready, running required; result optional.",
                  "fill": "$fg-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "layout: Inherit / side-by-side / stacked. workbenchMark: optional group; text plus tone Inherit / accent / contrast. Clearing the group removes it. Labels: empty, ready, running required; result optional.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"

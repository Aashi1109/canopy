        {
          "type": "frame",
          "id": "SnndN",
          "name": "Persistence and schema handoff",
          "width": "fill_container",
          "gap": 28,
          "children": [
            {
              "type": "frame",
              "id": "vJX4X",
              "name": "Draft state machine",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "F2Lo2w",
                  "name": "Draft heading",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Private draft, never an implicit publish",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "CHBcH",
                  "name": "Operation contract",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Job: configure a tool definition. Edit labeled data fields and union-specific controls; inspect effective values, validate, then save a private draft. The form is the task surface, not a JSON metadata recap.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "RZxbY",
                  "name": "Persistence transitions",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Edit → Unsaved. Save private draft → Validating… → Saving… → “Private draft r13 saved”. Stay on the current section. Review changes opens a diff; publishing requires a separate explicit confirmation outside these two screens.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "g9RuH0",
                  "name": "Recovery rules",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Save failure: “Could not save. Your edits are still here.” Offer Retry. Concurrent revision: “A newer draft exists.” Offer Review latest; never overwrite silently. Leaving with unsaved edits asks Keep editing or Discard. Returning loads the last saved private draft.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "F5quL",
                  "name": "Reset semantics",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Editing an inherited control creates an override, even if its value matches the default. Reset removes the override; it does not write a copy of the code default. Source provenance is shown beside each label. Reset input affects this section only and asks for confirmation.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "h2497p",
              "name": "Compatibility and validation specification",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "GQ26s",
                  "name": "Compatibility heading",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Implementation is the safety boundary",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "ejYU8",
                  "name": "Proposed resolver",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Future feature: validate a stored data-only override against ToolSpec and an implementation-owned compatibility manifest. Resolve code defaults + private draft for review; public pages keep the published revision. Do not execute database code.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Qsr0o",
                  "name": "Catalog validation",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Name and description: required nonblank strings. Category: registered category in the locked app. Keywords: trim comma-separated entries, omit empties and deduplicate. Mark text and tone are optional; tone is accent | contrast. Catalog icons are uploaded data, not definition fields.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "b4UuAR",
                  "name": "Optional values",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Blank optional property means omit, not zero or empty string. For inherited optionals, clearing requires an explicit “Remove optional value” tombstone; Reset returns to inheritance. Required input labels cannot be blank. Reject unknown keys, invalid enums and nonfinite, fractional or negative limits.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "W2N5Z",
                  "name": "Safety policy",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Proposed caps must be confirmed by the implementation owner, not inferred from configurable data. JSON: ≤2,000,000 chars; file ≤104,857,600 bytes; editable ≤2,000,000 bytes and ≤file cap. Reduced limits must be enforced in the workspace and execution boundary. Omitted limits never mean unlimited.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "c5WBN",
          "name": "Inline feedback specimens",
          "width": "fill_container",
          "gap": 16,
          "children": [
            {
              "id": "oIVkk",
              "type": "ref",
              "ref": "dV2U8",
              "name": "Validation error specimen",
              "width": "fill_container",
              "fill": "$danger-soft",
              "descendants": {
                "fF9w0": {
                  "icon": "circle-alert",
                  "fill": "$danger-text"
                },
                "TK55X": {
                  "content": "Max length exceeds the code limit"
                },
                "dTfwI": {
                  "content": "Enter 2,000,000 characters or fewer, or reset to inherited. Focus this field on save; keep all other edits. Save stays blocked until corrected."
                }
              }
            },
            {
              "id": "ELNrM",
              "type": "ref",
              "ref": "dV2U8",
              "name": "Private save success specimen",
              "width": "fill_container",
              "fill": "$success-soft",
              "descendants": {
                "fF9w0": {
                  "icon": "circle-check",
                  "fill": "$success-text"
                },
                "TK55X": {
                  "content": "Private draft r13 saved"
                },
                "dTfwI": {
                  "content": "No live changes. Continue to Input or Review changes. Keep this confirmation inline in the draft status; announce it to assistive technology."
                }
              }
            }
          ]
        },
        {
          "type": "text",
          "id": "mphc9",
          "name": "Coverage boundary",
          "fill": "$fg-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Coverage: these screens own identity, catalog, workbenchMark and every input union branch. Settings, trigger, capabilities, layout, optionsPanel, labels and content belong to the supplied neighboring sections; Definition JSON exposes the same validated data, not a bypass. Identity edits, new channels, engines and executable behavior still need code changes.",
          "lineHeight": 1.45,
          "fontFamily": "$font-body",
          "fontSize": 13,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "K4U91",
          "name": "Kind selection and accessibility",
          "fill": "$fg-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Kind menu: text selected; files / fields / none disabled for JSON Formatter, each with “Requires a compatible implementation”. Inspect opens the corresponding reference branch without changing the draft. Disabled help remains keyboard reachable. Labels, units, focus rings and inline errors must be linked to controls; long values wrap or scroll inside controls, never at page level.",
          "lineHeight": 1.45,
          "fontFamily": "$font-body",
          "fontSize": 13,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "S9mDp",
          "name": "Verification scope",
          "fill": "$fg-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",

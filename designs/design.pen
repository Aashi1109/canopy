                {
                  "type": "frame",
                  "id": "rXCLR",
                  "name": "05 / Readable controls, restrained surfaces",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "sqcCV",
                      "name": "05 / Readable controls, restrained surfaces",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "05 / Readable controls, restrained surfaces",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 20,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "X8e5l8",
                      "name": "05 / Readable controls, restrained surfaces detail",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Use existing controls and tokens. 16px editable values, 44px touch targets, 16px side gutters. Separate groups by 24px and controls by 8–12px where targets remain distinct. Structural borders stay; avoid boxing every label. Wrap long text and filenames; never truncate settings needed to make a choice.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "K1W1M",
                  "name": "06 / Feedback is part of the task",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "v2eiK",
                      "name": "06 / Feedback is part of the task",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "06 / Feedback is part of the task",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 20,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Bpo3a",
                      "name": "06 / Feedback is part of the task detail",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Keep input on error; point to the exact field, file or line. Retain usable results until replacement succeeds. Mark old output when inputs change. Show real progress only when measurable. Cancellation returns to an editable state. Copy/download feedback stays adjacent to the artifact.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "b2szRc",
                  "name": "07 / Motion and accessibility handoff",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "gK8HJ",
                      "name": "07 / Motion and accessibility handoff",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "07 / Motion and accessibility handoff",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 20,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "c0mUly",
                      "name": "07 / Motion and accessibility handoff detail",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "No entrance animation on routine edits. Press scale 0.96; respect reduced motion and support a static option. Label icon controls, disclose expanded state, return focus when closing options. Announce status changes without moving focus unexpectedly. Verify focus, zoom, RTL and real keyboard behavior in implementation.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "PTy8H",
              "name": "06 / Coverage, states and delivery checklist",
              "width": 1260,
              "layout": "vertical",
              "gap": 24,
              "children": [
                {
                  "type": "text",
                  "id": "CGrMs",
                  "name": "Coverage title",
                  "fill": "$fg-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Compatibility is a contract, not a universal canvas.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 30,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "pgMjU",
                  "name": "DevTools coverage",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "fYj92",
                      "name": "DevTools coverage",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "DevTools coverage",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 20,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "W0Ibo",
                      "name": "DevTools coverage detail",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "JSON / XML / CSV / code / text → editor. Diff / hash comparison → paired input + comparison. UUID / password / random / digest → generator or source + values. JWT / parsers / validators → inspector with located findings. QR / Markdown / HTML / CSS → source + real preview. Dates / units / colors → field-driven calculation. Network lookup → query + loading/error/result; never claim local-only processing for network tools.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "CvPxw",
                  "name": "Media coverage",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "q8MFzg",
                      "name": "Media coverage",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Media coverage",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 20,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "BawZv",
                      "name": "Media coverage detail",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Format conversion / compression / metadata removal → queue + useful preview. Crop / resize / rotate / flip / watermark → visual workspace with direct controls. PDF extract / reorder / delete / split / merge → portrait page selection and ordering. Page numbering / paper resizing → document preview with persistent settings. Combined images and social sizes → composition/safe-area preview.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "nsfke",
                  "name": "Generator transitions",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "HVV87",
                      "name": "Generator transitions",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Generator transitions",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 20,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "VDOIO",
                      "name": "Generator transitions detail",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Defaults: v4, quantity 5, hyphens on, uppercase off. Header Settings opens the shared bottom sheet. Closing retains edits but does not generate. Generate creates five UUIDs; Copy and Download include the full batch.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "ljZ78",
                  "name": "Generator recovery",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "SNoPj",
                      "name": "Generator recovery",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Generator recovery",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 20,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Q73oEU",
                      "name": "Generator recovery detail",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Count outside 1–100 or non-integer → inline “Enter a whole number from 1 to 100.”; do not run. Clipboard blocked → preserve selectable text and offer download. Crypto failure → preserve the prior batch and show Retry. Regenerate replaces values only on success; warn before the action. v7 includes a creation timestamp: show the privacy explanation when selected.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "ICj8d",
                  "name": "Coverage boundary",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "JLiSa",
                      "name": "Coverage boundary",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Coverage boundary",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 20,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "RiJ5m",
                      "name": "Coverage boundary detail",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "These are representative mobile approaches, not a claim that every tool route is already designed or implemented. Adapt each route’s existing fields and capabilities one-to-one. Do not invent output types, settings, undo behavior, progress precision or persistence.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "Q0z2Bj",
                  "name": "Review checklist",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "JK32j",
                      "name": "Review checklist",
                      "fill": "$fg-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Review checklist",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 20,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "a7GKmS",
                      "name": "Review checklist detail",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Check task visibility, unbroken layout, wrapping, alignment, contrast, panel boundaries and one primary action. End-user passes: problem fit; novice feasibility; five-second scan; feedback and recovery. Browser checks still required: 320/360/390px, landscape, zoom, keyboard, long strings, RTL, focus and runtime failures.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]
        },

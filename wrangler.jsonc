{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canopy",
  "main": "worker.ts",
  "tsconfig": "tsconfig.worker.json",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "minify": true,
  "workers_dev": true,
  "limits": {
    "cpu_ms": 30000,
  },
  "triggers": {
    "crons": ["*/30 * * * *", "0 0,12 * * *"],
  },
  "routes": [
    {
      "pattern": "smarttools.lol",
      "custom_domain": true,
    },
    {
      "pattern": "admin.smarttools.lol",
      "custom_domain": true,
    },
  ],
  "containers": [
    {
      "name": "canopy",
      "class_name": "CanopyContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1,
      "image_vars": { "APP_URL": "https://smarttools.lol" },
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "CANOPY_CONTAINER", "class_name": "CanopyContainer" }],
  },
  "migrations": [{ "tag": "v1-canopy-container", "new_sqlite_classes": ["CanopyContainer"] }],
  "vars": {
    "APP_URL": "https://smarttools.lol",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "canopy",
    },
  ],
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.7,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
  "env": {
    "dev": {
      "name": "canopy-dev",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "APP_URL": "https://canopy-dev.aashishpal50.workers.dev",
      },
      "containers": [
        {
          "name": "canopy-dev",
          "class_name": "CanopyContainer",
          "image": "./Dockerfile",
          "instance_type": "basic",
          "max_instances": 1,
          "image_vars": { "APP_URL": "https://canopy-dev.aashishpal50.workers.dev" },
        },
      ],
      "durable_objects": {
        "bindings": [{ "name": "CANOPY_CONTAINER", "class_name": "CanopyContainer" }],
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "canopy-dev",
        },
      ],
      "triggers": {
        "crons": [],
      },
      "observability": {
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.5,
        },
      },
    },
  },
}
